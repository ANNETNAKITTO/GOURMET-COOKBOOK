            init() {
                this.loadFromStorage();
                this.renderRecipes();
                this.setupEventListeners();
                this.hideSplash();
                this.checkInstallPrompt();
                this.updateRecipeCount();
            },

            setupEventListeners() {
                window.addEventListener('beforeinstallprompt', (e) => {
                    e.preventDefault();
                    this.deferredPrompt = e;
                    setTimeout(() => this.showInstallPrompt(), 3000);
                });
            },

            hideSplash() {
                setTimeout(() => {
                    document.getElementById('splash').style.opacity = '0';
                    setTimeout(() => document.getElementById('splash').style.display = 'none', 500);
                }, 1500);
            },

            checkInstallPrompt() {
                if (window.matchMedia('(display-mode: standalone)').matches) return;
                if (localStorage.getItem('installDismissed')) return;
            },

            showInstallPrompt() {
                document.getElementById('installPrompt').classList.remove('hidden');
                document.getElementById('installPrompt').classList.add('flex');
            },

            dismissInstall() {
                document.getElementById('installPrompt').classList.add('hidden');
                document.getElementById('installPrompt').classList.remove('flex');
                localStorage.setItem('installDismissed', 'true');
            },

            async installApp() {
                if (!this.deferredPrompt) return;
                this.deferredPrompt.prompt();
                const { outcome } = await this.deferredPrompt.userChoice;
                if (outcome === 'accepted') this.showToast('App installed!');
                this.dismissInstall();
            },

            loadFromStorage() {
                const saved = localStorage.getItem('gourmetRecipes');
                if (saved) this.recipes = JSON.parse(saved);
            },

            saveToStorage() {
                localStorage.setItem('gourmetRecipes', JSON.stringify(this.recipes));
            },

            updateRecipeCount() {
                document.getElementById('recipeCount').textContent = `${this.recipes.length} recipes available offline`;
            },

            renderRecipes() {
                const grid = document.getElementById('recipeGrid');
                const emptyState = document.getElementById('emptyState');
                
                let filtered = this.currentFilter === 'favorites' 
                    ? this.recipes.filter(r => r.favorite)
                    : this.currentFilter === 'all'
                        ? this.recipes
                        : this.recipes.filter(r => r.category === this.currentFilter);

                if (filtered.length === 0) {
                    grid.innerHTML = '';
                    emptyState.classList.remove('hidden');
                    return;
                }

                emptyState.classList.add('hidden');
                grid.innerHTML = filtered.map((recipe, index) => `
                    <div class="bg-white rounded-2xl overflow-hidden shadow-sm border border-chef-100 animate-slide-up touch-active" 
                         style="animation-delay: ${index * 0.05}s"
                         onclick="app.openRecipe(${recipe.id})">
                        <div class="h-48 relative">
                            <img src="${recipe.image}" class="w-full h-full object-cover" loading="lazy">
                            <button onclick="event.stopPropagation(); app.toggleFavorite(${recipe.id})" 
                                    class="absolute top-3 right-3 w-10 h-10 bg-white/90 backdrop-blur rounded-full flex items-center justify-center shadow-md ${recipe.favorite ? 'text-red-500' : 'text-chef-400'}">
                                <i class="${recipe.favorite ? 'fas' : 'far'} fa-heart"></i>
                            </button>
                            <span class="absolute bottom-3 left-3 px-3 py-1 bg-white/90 backdrop-blur rounded-full text-xs font-semibold uppercase">${recipe.category}</span>
                        </div>
                        <div class="p-4">
                            <h3 class="font-serif text-lg font-bold mb-1">${recipe.title}</h3>
                            <div class="flex items-center justify-between text-sm text-chef-500">
                                <span><i class="far fa-clock mr-1"></i>${recipe.time} min</span>
                                <span>${recipe.ingredients.length} ingredients</span>
                            </div>
                        </div>
                    </div>
                `).join('');
            },

            openRecipe(id) {
                const recipe = this.recipes.find(r => r.id === id);
                const modal = document.getElementById('detailModal');
                const content = document.getElementById('detailContent');
                
                content.innerHTML = `
                    <div class="relative h-72">
                        <img src="${recipe.image}" class="w-full h-full object-cover">
                        <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
                        <button onclick="app.closeDetailModal()" class="absolute top-4 left-4 w-10 h-10 bg-white/20 backdrop-blur rounded-full flex items-center justify-center text-white">
                            <i class="fas fa-arrow-left"></i>
                        </button>
                        <button onclick="app.toggleFavorite(${recipe.id}); app.openRecipe(${recipe.id})" 
                                class="absolute top-4 right-4 w-10 h-10 bg-white rounded-full flex items-center justify-center shadow-lg ${recipe.favorite ? 'text-red-500' : 'text-chef-400'}">
                            <i class="${recipe.favorite ? 'fas' : 'far'} fa-heart"></i>
                        </button>
                        <div class="absolute bottom-0 left-0 p-6 text-white">
                            <h2 class="font-serif text-3xl font-bold mb-2">${recipe.title}</h2>
                            <div class="flex gap-4 text-sm opacity-90">
                                <span><i class="far fa-clock mr-1"></i>${recipe.time} min</span>
                                <span><i class="fas fa-signal mr-1"></i>${recipe.difficulty}</span>
                            </div>
                        </div>
                    </div>
                    <div class="p-6 pb-24">
                        <div class="mb-6">
                            <h3 class="font-serif text-xl font-bold mb-4">Ingredients</h3>
                            <div class="space-y-2">
                                ${recipe.ingredients.map((ing, i) => `
                                    <label class="flex items-center gap-3 p-3 bg-chef-50 rounded-xl touch-active">
                                        <input type="checkbox" class="w-5 h-5 rounded border-chef-300 text-chef-600 focus:ring-chef-500">
                                        <span class="text-chef-800">${ing}</span>
                                    </label>
                                `).join('')}
                            </div>
                        </div>
                        <div>
                            <h3 class="font-serif text-xl font-bold mb-4">Instructions</h3>
                            <div class="space-y-4">
                                ${recipe.instructions.map((step, i) => `
                                    <div class="flex gap-4">
                                        <div class="flex-shrink-0 w-8 h-8 bg-chef-800 text-white rounded-full flex items-center justify-center font-bold text-sm">${i + 1}</div>
                                        <p class="text-chef-800 leading-relaxed pt-1">${step}</p>
                                    </div>
                                `).join('')}
                            </div>
                        </div>
                        <div class="mt-8 p-4 bg-chef-100 rounded-xl">
                            <p class="text-sm text-chef-700"><i class="fas fa-lightbulb mr-2"></i>Tip: ${recipe.author} suggests preparing all ingredients before starting.</p>
                        </div>
                    </div>
                `;
                
                modal.classList.remove('hidden');
                document.body.style.overflow = 'hidden';
            },

            closeDetailModal() {
                document.getElementById('detailModal').classList.add('hidden');
                document.body.style.overflow = '';
            },

            toggleFavorite(id) {
                const recipe = this.recipes.find(r => r.id === id);
                recipe.favorite = !recipe.favorite;
                this.saveToStorage();
                this.renderRecipes();
                this.showToast(recipe.favorite ? 'Added to favorites' : 'Removed from favorites');
            },

            filterCategory(category) {
                this.currentFilter = category;
                document.querySelectorAll('.category-pill').forEach(pill => {
                    pill.classList.remove('active', 'bg-chef-800', 'text-white');
                    pill.classList.add('bg-white', 'text-chef-700');
                });
                event.target.closest('button').classList.add('active', 'bg-chef-800', 'text-white');
                event.target.closest('button').classList.remove('bg-white', 'text-chef-700');
                this.renderRecipes();
            },

            toggleSearch() {
                const bar = document.getElementById('searchBar');
                bar.classList.toggle('hidden');
                if (!bar.classList.contains('hidden')) document.getElementById('searchInput').focus();
            },

            handleSearch(query) {
                const lower = query.toLowerCase();
                const filtered = this.recipes.filter(r => 
                    r.title.toLowerCase().includes(lower) || 
                    r.ingredients.some(i => i.toLowerCase().includes(lower))
                );
                const grid = document.getElementById('recipeGrid');
                grid.innerHTML = filtered.map(recipe => `
                    <div class="bg-white rounded-2xl overflow-hidden shadow-sm border border-chef-100 touch-active" onclick="app.openRecipe(${recipe.id})">
                        <div class="h-48 relative"><img src="${recipe.image}" class="w-full h-full object-cover"></div>
                        <div class="p-4"><h3 class="font-serif text-lg font-bold">${recipe.title}</h3></div>
                    </div>
                `).join('');
            },

            showAddModal() {
                document.getElementById('addModal').classList.remove('hidden');
            },

            closeAddModal() {
                document.getElementById('addModal').classList.add('hidden');
                document.getElementById('addRecipeForm').reset();
            },

            handleAddRecipe(e) {
                e.preventDefault();
                const form = e.target;
                const newRecipe = {
                    id: Date.now(),
                    title: form.title.value,
                    category: form.category.value,
                    time: parseInt(form.time.value),
                    image: form.image.value || 'https://images.unsplash.com/photo-1495521821757-a1efb6729352?w=800',
                    ingredients: form.ingredients.value.split('\n').filter(i => i.trim()),
                    instructions: form.instructions.value.split('\n').filter(i => i.trim()),
                    favorite: false,
                    author: "You",
                    difficulty: "Medium"
                };
                this.recipes.unshift(newRecipe);
                this.saveToStorage();
                this.renderRecipes();
                this.updateRecipeCount();
                this.closeAddModal();
                this.showToast('Recipe saved!');
            },

            showSettings() {
                document.getElementById('settingsModal').classList.remove('hidden');
            },

            closeSettings() {
                document.getElementById('settingsModal').classList.add('hidden');
            },

            clearData() {
                if (confirm('Reset all data? This cannot be undone.')) {
                    localStorage.removeItem('gourmetRecipes');
                    location.reload();
                }
            },

            goHome() {
                this.currentFilter = 'all';
                this.renderRecipes();
                window.scrollTo({ top: 0, behavior: 'smooth' });
            },

            showToast(message) {
                const toast = document.getElementById('toast');
                document.getElementById('toastMessage').textContent = message;
                toast.classList.remove('-translate-y-20', 'opacity-0');
                setTimeout(() => toast.classList.add('-translate-y-20', 'opacity-0'), 2500);
            },

            resetFilters() {
                this.currentFilter = 'all';
                document.getElementById('searchInput').value = '';
                this.renderRecipes();
            }
        };

        document.addEventListener('DOMContentLoaded', () => app.init());
    </script>
</body>
